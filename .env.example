# Copy this file to .env and fill in values. Do not commit .env.

# --- API Configuration ---
EXPO_PUBLIC_API_MODE=real
# Backend base URL (use your machine's IP for local dev, or your deployed URL)
EXPO_PUBLIC_API_URL=http://YOUR_IP_OR_HOST:8080

# --- Firebase ---
# Web API Key: Firebase Console → Project settings → General → Web API Key
EXPO_PUBLIC_FIREBASE_API_KEY=

# --- Firebase Emulator (local dev only) ---
# Use the same LAN IP as EXPO_PUBLIC_API_URL so physical devices can reach emulators.
# Comment out all three lines when using production Firebase + Storage only.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=YOUR_LAN_IP:9099
# Physical devices must use your Mac's LAN IP (not localhost). Token refresh calls this host directly.
# EXPO_PUBLIC_TOKEN_REFRESH_FETCH_TIMEOUT_MS=15000
# EXPO_PUBLIC_STORAGE_EMULATOR_PUBLIC_HOST=YOUR_LAN_IP:9199
# Server should also set FIREBASE_STORAGE_EMULATOR_DOWNLOAD_HOST=YOUR_LAN_IP:9199 (cloth-in-server .env).
