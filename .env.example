# Copy this file to .env and fill in values. Do not commit .env.

# --- API Configuration ---
EXPO_PUBLIC_API_MODE=real
# Backend base URL (use your machine's IP for local dev, or your deployed URL)
EXPO_PUBLIC_API_URL=http://YOUR_IP_OR_HOST:8080

# --- Firebase ---
# Web API Key: Firebase Console → Project settings → General → Web API Key
EXPO_PUBLIC_FIREBASE_API_KEY=

# --- Firebase Emulator (local dev only) ---
# Set this to route auth token refresh to the local emulator instead of Google's servers.
# Leave commented out (or remove) when using real Firebase in production.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
